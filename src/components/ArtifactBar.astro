---
/**
 * Print / PDF / PNG / Pinterest. The PNG is a real file on disk, so the
 * download and the pin both point at the same asset Google indexes.
 */
import { absolute } from '../lib/site.mjs';
import { pdfPath, downloadName as fileName } from '../lib/assets.mjs';

const {
  png,               // path to the 1000x1500 PNG
  pageUrl,           // canonical page url, used for the pin
  description,       // pin description
  note = 'Free. No sign-up. A4 + US Letter.',
  printTarget = null, // id of a single .print-sheet to print, or null for the whole page
  downloadName,
} = Astro.props;

const pinUrl =
  'https://pinterest.com/pin/create/button/?url=' +
  encodeURIComponent(absolute(pageUrl)) +
  '&media=' + encodeURIComponent(absolute(png)) +
  '&description=' + encodeURIComponent(description);
---

<div class="artifact-bar">
  <button class="btn btn--primary" type="button" data-print={printTarget ?? 'all'}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"/></svg>
    Print
  </button>
  <a class="btn" href={pdfPath(png)} download={fileName(pdfPath(png))}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4"/></svg>
    Download PDF
  </a>
  <a class="btn" href={png} download={downloadName}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5h18v14H3z"/><path d="m3 16 5-5 4 4 3-3 6 6"/></svg>
    Download PNG
  </a>
  <a class="btn btn--pin" href={pinUrl} rel="nofollow noopener" target="_blank">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.3 1 .5 1.9 1.6 1.9 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.1-3.8-3 0-4.9 2.2-4.9 4.7 0 .9.3 1.5.7 2 .2.2.2.3.1.6l-.2.8c-.1.3-.3.4-.5.3-1.4-.6-2-2.1-2-3.8 0-2.8 2.4-6.2 7-6.2 3.7 0 6.2 2.7 6.2 5.6 0 3.8-2.1 6.7-5.3 6.7-1 0-2-.6-2.4-1.2l-.6 2.5c-.2.8-.7 1.7-1.1 2.3A10 10 0 1 0 12 2z"/></svg>
    Save to Pinterest
  </a>
  <p class="note">{note}</p>
</div>
