---
import { SITE, NAV } from '../lib/site.mjs';
---

<header class="site-header">
  <div class="shell header-row">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{SITE.name}</a>
    <nav class="site-nav" aria-label="Main">
      {NAV.map((item) => <a href={item.url}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="/printable-chord-chart/">All sheets</a>
  </div>
</header>
