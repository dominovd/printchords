---
/**
 * The collection template. Used by index.astro for the chart that lives on the
 * root and by [chart].astro for every other one, so both go through exactly the
 * same markup.
 */
import Base from '../layouts/Base.astro';
import ChordDiagram from './ChordDiagram.astro';
import ArtifactBar from './ArtifactBar.astro';
import PrintRegion from './PrintRegion.astro';
import Faq from './Faq.astro';
import TeacherNote from './TeacherNote.astro';
import { charts, chartUrl } from '../data/charts.mjs';
import { getChord, primaryVariant, sheetImagePath } from '../lib/chords.mjs';
import { chartSheetSvg } from '../lib/diagram.mjs';
import { SITE, CHEAPEST_ENTRIES, absolute } from '../lib/site.mjs';
import { pageSchema } from '../lib/schema.mjs';

const { chart } = Astro.props;
const url = chartUrl(chart);
const isRoot = url === '/';

const entries = chart.chords.map((id) => {
  const chord = getChord(id);
  return { chord, shape: primaryVariant(chord) };
});

const sheetPng = sheetImagePath(chart.id);
const sheetSvg = chartSheetSvg({ title: chart.title, subtitle: chart.sheetSubtitle, chords: entries });
const otherCharts = charts.filter((c) => c.id !== chart.id);
const chordPages = entries.filter(({ chord }) => chord.pageUrl);

const breadcrumb = isRoot
  ? [{ name: chart.title, url: '/' }]
  : [{ name: 'Home', url: '/' }, { name: chart.title, url }];

const schema = pageSchema({
  name: chart.title,
  url,
  description: chart.metaDescription,
  image: sheetPng,
  imageAlt: chart.imageAlt,
  breadcrumb,
  faq: chart.faq,
  isRoot,
});
---

<Base
  title={chart.metaTitle}
  description={chart.metaDescription}
  canonical={url}
  ogImage={sheetPng}
  ogImageAlt={chart.imageAlt}
  schema={schema}
>
  {!isRoot && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>›</span>
      <span aria-current="page">{chart.title}</span>
    </nav>
  )}

  <h1>{chart.title}</h1>
  <p class="lead">{chart.lead}</p>

  <div class="chord-grid">
    {entries.map(({ chord, shape }) => (
      <article class="chord-card">
        <ChordDiagram shape={shape} label={`${chord.full} chord diagram, ${shape.label}`} />
        <div class="chord-name">
          {chord.pageUrl ? <a href={chord.pageUrl}>{chord.name}</a> : <span>{chord.name}</span>}
        </div>
      </article>
    ))}
  </div>

  <ArtifactBar
    png={sheetPng}
    pageUrl={url}
    description={`${chart.title}. ${chart.sheetSubtitle}. Free printable from ${SITE.domain}`}
    downloadName={`${chart.id}.png`}
  />

  <section class="feature">
    <div>
      <h2 class="section-title">Printable version</h2>
      <img
        class="print-preview"
        src={sheetPng}
        width="1000"
        height="1500"
        alt={chart.imageAlt}
        decoding="async"
      />
    </div>
    <div class="intro">
      <h2 class="section-title">How to use this chart</h2>
      {chart.intro.map((paragraph) => <p>{paragraph}</p>)}
      <TeacherNote sheet="this chart" />
      {chart.steps.map((step, index) => (
        <div class="step">
          <span class="num">{index + 1}</span>
          <span><strong>{step.title}</strong>{step.text}</span>
        </div>
      ))}
      <div class="quick-links">
        {otherCharts.map((other) => <a href={chartUrl(other)}>{other.title}</a>)}
        {CHEAPEST_ENTRIES
          .filter((item) => item.url !== url && !otherCharts.some((c) => chartUrl(c) === item.url))
          .map((item) => <a href={item.url}>{item.title}</a>)}
      </div>
    </div>
  </section>

  {chordPages.length > 0 && (
    <section class="section">
      <h2 class="section-title">Chords with more than one shape</h2>
      <p class="section-lead">
        Most chords on this sheet have one grip worth knowing. These have several, and the choice changes how easy
        the next chord is. Each of them has its own page.
      </p>
      <div class="card-grid">
        {chordPages.map(({ chord, shape }) => (
          <a class="link-card link-card--with-diagram" href={chord.pageUrl}>
            <ChordDiagram shape={shape} label={`${chord.full}, ${shape.label}`} />
            <b>{chord.full}</b>
            <span>{chord.variants.length} fingerings · {chord.notes.join(' · ')}</span>
            <em>View chord →</em>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <h2 class="section-title">Other printable sheets</h2>
    <div class="card-grid">
      {otherCharts.map((other) => (
        <a class="link-card" href={chartUrl(other)}>
          <b>{other.title}</b>
          <span>{other.lead}</span>
          <em>View chart →</em>
        </a>
      ))}
      {CHEAPEST_ENTRIES
        .filter((item) => item.url !== url && !otherCharts.some((c) => chartUrl(c) === item.url))
        .map((item) => (
        <a class="link-card" href={item.url}>
          <b>{item.title}</b>
          <span>{item.text}</span>
          <em>View sheet →</em>
        </a>
      ))}
    </div>
  </section>

  <Faq items={chart.faq} />

  <PrintRegion slot="print" sheets={[{ id: chart.id, svg: sheetSvg }]} />
</Base>
